# Copy to .env (git-ignored) and adjust. Read automatically by docker compose.
# Keep comments on their own lines.

# Your host user/group ids: output of `id -u` and `id -g`
HOST_UID=501
HOST_GID=20

ROS_DOMAIN_ID=48

# noVNC (GUI in the browser at http://localhost:NOVNC_PORT)
NOVNC_PORT=8080
NOVNC_RESOLUTION=1920x1080x24
# 127.0.0.1 on laptops. On the car: 0.0.0.0 to reach it over WiFi, and set a password.
NOVNC_BIND=127.0.0.1
# VNC only uses the first 8 characters of the password.
VNC_PASSWORD=
