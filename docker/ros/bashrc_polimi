# Sourced from ~/.bashrc in the F1tenth_PoliMI containers.
source /opt/ros/humble/setup.bash
[ -f /opt/sim_ws/install/setup.bash ] && source /opt/sim_ws/install/setup.bash
[ -f "$HOME/ws/install/setup.bash" ] && source "$HOME/ws/install/setup.bash"

# Functions, not aliases: they also work in `docker compose exec arm bash -c "source /etc/bashrc_polimi && cb"`.
sauce() {
    source /opt/ros/humble/setup.bash
    [ -f /opt/sim_ws/install/setup.bash ] && source /opt/sim_ws/install/setup.bash
    [ -f "$HOME/ws/install/setup.bash" ] && source "$HOME/ws/install/setup.bash"
}
# Arguments go to colcon: cb --packages-select f1tenth_stack
cb() { (cd "$HOME/ws" && colcon build --symlink-install "$@") && sauce; }

# Simulator with one of our configs from ~/ws/config/sim (bind-mounted from ros2_ws/config/sim).
#   sim                       -> sim_sl450.yaml (default)
#   sim sim_sl450 num_agent:=2
#   sim sim.yaml              -> upstream config shipped with f1tenth_gym_ros
# Arguments after the config name go straight to ros2 launch.
sim() {
    local cfg="sim_sl450"
    if [ $# -gt 0 ] && [[ "$1" != *":="* ]]; then cfg="$1"; shift; fi
    local path="$HOME/ws/config/sim/${cfg%.yaml}.yaml"
    [ -f "$path" ] || path="$cfg"   # not ours: let the launch file look in the package's config/
    echo "sim config: $path"
    ros2 launch f1tenth_gym_ros gym_bridge_launch.py open_foxglove:=false config:="$path" "$@"
}

# Simulator as the car (polimi_sim): gym + LiDAR / actuation / odometry models + the car's mux.
#   simcar                    -> levine
#   simcar spielberg debug_map_to_odom:=truth
# The first argument is a config name in ~/ws/config/sim; the rest goes straight to ros2 launch.
simcar() {
    local map="levine"
    if [ $# -gt 0 ] && [[ "$1" != *":="* ]]; then map="$1"; shift; fi
    ros2 launch polimi_sim sim_car.launch.py map:="$map" "$@"
}
